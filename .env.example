# App
APP_NAME=GovExamAgent
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
REQUEST_CONCURRENCY_LIMIT=80
WORKER_THREAD_POOL_SIZE=8

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=gov_exam_agent
POSTGRES_USER=gov_exam
POSTGRES_PASSWORD=gov_exam_password
DATABASE_URL=postgresql+asyncpg://gov_exam:gov_exam_password@localhost:5434/gov_exam_agent

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19532
MILVUS_COLLECTION=gov_exam_knowledge
MILVUS_VECTOR_DIM=1024

# LLM, OpenAI-compatible
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_FALLBACK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0
RAG_TIMEOUT_SECONDS=3
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=true
ENABLE_LOCAL_MODELS=false
ENABLE_MILVUS_RAG=false
ENABLE_LOCAL_SEMANTIC_RAG=false
ENABLE_QUERY_CLASSIFIER=true
GRAPH_MEMORY_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Embedding and rerank
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_M3_MODEL_PATH=./models/embedding/bge-m3
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=./models/classifier/all-MiniLM-L6-v2
FINETUNED_CLASSIFIER_PATH=./models/classifier/query-classifier-finetuned

# MCP
KB_MCP_SERVER_URL=http://localhost:8000/mcp/kb
WEB_SEARCH_MCP_URL=http://localhost:8000/mcp/web-search

# Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
