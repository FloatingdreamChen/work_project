# App
APP_NAME=GovExamAgent
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=gov_exam_agent
POSTGRES_USER=gov_exam
POSTGRES_PASSWORD=gov_exam_password
DATABASE_URL=postgresql+asyncpg://gov_exam:gov_exam_password@localhost:5434/gov_exam_agent

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19532
MILVUS_COLLECTION=gov_exam_knowledge

# LLM, OpenAI-compatible
OPENAI_API_KEY=sk-0879c101201a4848853c821b089e51a1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Embedding and rerank
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
